# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- MongoDB ---
# Must point at a replica set — required for retryWrites and for the
# rolling-window aggregation-pipeline update used later in the counter engine.
MONGO_URI=mongodb://localhost:27017/imps_velocity?replicaSet=rs0
MONGO_DB_NAME=imps_velocity

# --- Admin API credentials ---
# Comma-separated list of admin API keys. Deliberately a separate credential
# space from tenant API keys (STORY-01-01 DoD: admin role uses a separate
# credential from tenant API credentials). Rotate by editing this list.
ADMIN_API_KEYS=change-me-admin-key

# --- Tenant auth ---
# Mechanism is API key for this release (BRD Notes/Risks on STORY-01-02: the
# choice of API key vs mTLS vs OAuth is an open item pending bank sign-off).
API_KEY_HEADER=x-api-key
ADMIN_API_KEY_HEADER=x-admin-api-key
