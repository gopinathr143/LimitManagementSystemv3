# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- MongoDB ---
# Must point at a replica set — required for retryWrites and for the
# rolling-window aggregation-pipeline update used later in the counter engine.
#
# Two ways to configure this (src/config/env.js):
#   1. MONGO_URI — a full connection string, used verbatim if set. Simplest
#      for local dev / CI (no auth needed against docker-compose's mongo).
#   2. Otherwise, assembled from the discrete vars below — the shape a real
#      multi-node replica set wants: hosts/replicaSet/authSource are not
#      secret (fine in a ConfigMap); only MONGO_PASSWORD is a Secret value,
#      and it is passed to the driver separately, never embedded in a
#      connection string. Leave MONGO_URI unset to use this path.
MONGO_URI=mongodb://localhost:27017/imps_velocity?replicaSet=rs0
MONGO_DB_NAME=imps_velocity
# MONGO_HOSTS=mongo-a.internal:27017,mongo-b.internal:27017,mongo-c.internal:27017
# MONGO_REPLICA_SET=rs0
# MONGO_AUTH_SOURCE=admin
# MONGO_USERNAME=imps_velocity_app
# MONGO_PASSWORD=              # secret — supply via a Secret/secrets manager, never commit a real value

# --- No authentication ---
# Deliberate decision: callers are trusted same-cluster consumers. clientId
# is taken directly from the request path; its existence and ACTIVE status
# are still validated and fail closed (see src/middleware/resolveClientId.middleware.js).
# ACTOR_HEADER is an optional, unverified caller-supplied identifier recorded
# on audit trail entries — not a credential.
# Revisit with OAuth + scopes if this API is ever exposed beyond the cluster.
ACTOR_HEADER=x-actor-id
