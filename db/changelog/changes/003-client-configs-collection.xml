<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/mongodb
        http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <!--
        BRD §4.3 — one versioned dimension-registry snapshot per client.
        _id IS the clientId, same rationale as `clients` (STORY-01-01):
        the primary-key index gives lookup for free and there is exactly
        one document per tenant, so there is no "other tenant" a query
        against this collection could leak into.

        STORY-08-03 — `directions` (a map keyed by OUTWARD/INWARD, each an
        object carrying that direction's own `allowedDimensions`) is now the
        stored shape. `allowedDimensions` remains listed as an optional
        top-level property purely for backward-compatible documentation: a
        legacy pre-EPIC-08 document (top-level `allowedDimensions`, no
        `directions`) is normalized to the new shape at READ time
        (`normalizeRegistryDoc`, registry.model.js) rather than migrated in
        place, so both shapes can coexist in this collection.
    -->
    <changeSet id="001-create-client-configs-collection" author="imps-velocity">
        <mongodb:createCollection collectionName="clientConfigs">
            <mongodb:options>
                {
                  "validator": {
                    "$jsonSchema": {
                      "bsonType": "object",
                      "required": ["_id", "clientId", "configVersion", "limitsVersion", "createdAt", "updatedAt"],
                      "properties": {
                        "_id": { "bsonType": "string", "description": "clientId" },
                        "clientId": { "bsonType": "string" },
                        "configVersion": { "bsonType": "number", "minimum": 1 },
                        "limitsVersion": { "bsonType": "number", "minimum": 0 },
                        "directions": { "bsonType": ["object", "null"], "description": "keyed by OUTWARD/INWARD, each {allowedDimensions: array}" },
                        "allowedDimensions": { "bsonType": ["array", "null"], "description": "legacy pre-EPIC-08 shape only; normalized at read time" },
                        "createdBy": { "bsonType": "string" },
                        "updatedBy": { "bsonType": "string" },
                        "createdAt": { "bsonType": "date" },
                        "updatedAt": { "bsonType": "date" }
                      }
                    }
                  },
                  "validationLevel": "strict",
                  "validationAction": "error"
                }
            </mongodb:options>
        </mongodb:createCollection>
    </changeSet>

    <changeSet id="002-client-configs-unique-clientid-idx" author="imps-velocity">
        <mongodb:createIndex collectionName="clientConfigs">
            <mongodb:keys>{ "clientId": 1 }</mongodb:keys>
            <mongodb:options>{ "unique": true, "name": "idx_clientConfigs_clientId_unique" }</mongodb:options>
        </mongodb:createIndex>
    </changeSet>

</databaseChangeLog>
