# Yarn Classic (1.x) config. package.json pins engines.node to the exact
# release target (24.12.0) per project policy. This machine currently runs a
# different Node version and has no version manager installed, so the engine
# check is relaxed for local installs only — CI/production must still run on
# 24.12.0. See .nvmrc / .node-version for the pinned version.
ignore-engines true
registry "https://registry.npmjs.org"
